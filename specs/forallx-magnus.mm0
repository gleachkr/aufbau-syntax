-- forallx (original, P.D. Magnus) — the acid test of the design: a system
-- with juxtaposed variadic atomic sentences (`Fx`, `Rxy`, `Rabc`) as pure
-- data, no code. Per Carnap's `magnusFOLParserOptions`: predicates A–Z
-- with arguments glued straight on, sentence letters A–Z (the same
-- declarations, elided), constants a–w, variables x–z, identity, no
-- function symbols; open formulas are allowed (no closed-sentences lint),
-- and parentheses may group anything.
--
-- `@syntax juxtaposed` on the sequence combiner is what changes against
-- Calgary: adjacency at seq denotes scomma, so a predicate's arguments
-- glue. The `A`-as-∀ ambiguity resolves exactly as in Carnap, because the
-- quantifier reading is tried before the name reading: `AxFx` is a
-- quantified formula, `Axy` is the predicate A of x and y.

delimiter $ ( ) , $;

provable sort wff;

--| @vars x y z
sort var;
--| @vars a b c d e f g h i j k l m n o p q r s t u v w
sort name;
sort tm;
sort seq;

term v2t (x: var): tm;
coercion v2t: var > tm;
term n2t (a: name): tm;
coercion n2t: name > tm;
term t2s (t: tm): seq;
coercion t2s: tm > seq;

--| @syntax elided
term snil: seq;
--| @syntax juxtaposed
term scomma (s t: seq): seq;
infixl scomma: $,$ prec 10;

term A (s: seq): wff;
term B (s: seq): wff;
term C (s: seq): wff;
term D (s: seq): wff;
term E (s: seq): wff;
term F (s: seq): wff;
term G (s: seq): wff;
term H (s: seq): wff;
term I (s: seq): wff;
term J (s: seq): wff;
term K (s: seq): wff;
term L (s: seq): wff;
term M (s: seq): wff;
term N (s: seq): wff;
term O (s: seq): wff;
term P (s: seq): wff;
term Q (s: seq): wff;
term R (s: seq): wff;
term S (s: seq): wff;
term T (s: seq): wff;
term U (s: seq): wff;
term V (s: seq): wff;
term W (s: seq): wff;
term X (s: seq): wff;
term Y (s: seq): wff;
term Z (s: seq): wff;

--| @syntax role negation
term not (p: wff): wff;
prefix not: $-$ prec 50;
prefix not: $~$ prec 50;
prefix not: $¬$ prec 50;

--| @syntax role conjunction
term and (p q: wff): wff;
infixl and: $/\$ prec 40;
infixl and: $&$ prec 40;
infixl and: $∧$ prec 40;

--| @syntax role disjunction
term or (p q: wff): wff;
infixl or: $\/$ prec 35;
infixl or: $∨$ prec 35;

--| @syntax role conditional
term imp (p q: wff): wff;
infixr imp: $->$ prec 30;
infixr imp: $→$ prec 30;

--| @syntax role biconditional
term iff (p q: wff): wff;
infixl iff: $<->$ prec 25;
infixl iff: $↔$ prec 25;

--| @syntax role forall
term all {x: var} (p: wff x): wff;
prefix all: $A$ prec 50;
prefix all: $∀$ prec 50;

--| @syntax role exists
term ex {x: var} (p: wff x): wff;
prefix ex: $E$ prec 50;
prefix ex: $∃$ prec 50;

--| @syntax role identity
term ideq (s t: tm): wff;
infixl ideq: $=$ prec 60;

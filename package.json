{
  "name": "@aufbau/syntax",
  "version": "0.0.1",
  "description": "Surface syntax over MM0: a statement reader, a character-level scanner, a faithful math-string parser, a pretty-printer, and a bidirectional token-elaboration layer for textbook logical notations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gleachkr/aufbau-syntax.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:check": "biome ci .",
    "prepack": "bun run build",
    "test": "bun test",
    "validate": "bun test && bun run check && bun run lint:check"
  },
  "devDependencies": {
    "@aufbau/compiler": "0.0.6",
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
